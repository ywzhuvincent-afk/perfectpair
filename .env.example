NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this value with NEXT_PUBLIC_ or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=replace-with-a-long-random-value
# Server-only operator console credentials. Set both in the production host;
# do not prefix either name with NEXT_PUBLIC_.
ADMIN_ACCESS_CODE=replace-with-a-unique-long-passphrase
ADMIN_SESSION_SECRET=replace-with-a-long-random-signing-secret
